# =========================================================
# Sara AI - .gitignore
# =========================================================

# ---------- Secrets / Credentials ----------
.env
.env.*
!.env.example
env.txt
credentials.json
token.json
client_secret*.json
client_secrets*.json
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
*.jks
*.keystore
*.cookies
cookies*.txt
session*.json

# ---------- Personal / Private Data ----------
sara_data.db
sara_data.db-wal
sara_data.db-shm
sara_data.db-journal
*.db
*.db-wal
*.db-shm
*.db-journal
*.sqlite
*.sqlite3
sara_notes*.txt
sara_todos*.txt
memory_export*.json
analytics_usage*.json
*.jsonl
!bench/golden/*.jsonl
!bench/redteam/*.jsonl

# ---------- Audio Privacy ----------
*.wav
*.mp3
*.flac
*.ogg
*.m4a
recordings/
captures/

# ---------- AI Models ----------
models/
*.onnx
*.safetensors
*.gguf
*.pt
*.pth
*.bin
*.ckpt

# ---------- Runtime ----------
data/
logs/
*.log
cache/
exports/
tmp/
temp/
scratch/

# ---------- Build output ----------
build/
dist/
*.spec.bak
*.egg-info/

# ---------- Python ----------
__pycache__/
*.py[cod]
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# ---------- QA / dev scaffolding ----------
qa_results.json
qa_tester.py
simulate_*.py
scratch_*.py
apply_*.py
check_patches.py

# ---------- IDE / OS ----------
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini