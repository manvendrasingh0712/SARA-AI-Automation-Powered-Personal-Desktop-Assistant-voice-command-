from pathlib import Path

content = r"""# ==========================================
# SARA AI - .gitignore
# ==========================================

# ============================================================
# SECRETS / CREDENTIALS
# ============================================================

.env
.env.*
!.env.example

credentials.json
token.json
secrets.json

*.pem
*.key
*.p12
*.pfx
*.crt
*.cer

# ============================================================
# PYTHON CACHE / GENERATED BYTECODE
# ============================================================

__pycache__/
*.py[cod]
*.pyo
*.pyd
*$py.class

*.egg-info/
.eggs/
.Python
*.so

# ============================================================
# VIRTUAL ENVIRONMENTS
# ============================================================

.venv/
venv/
env/
ENV/
.conda/
conda-env/

# ============================================================
# PROJECT-LOCAL ENV / MACHINE-SPECIFIC CONFIG
# ============================================================

# SARA currently uses env.txt as local machine configuration.
# Do not publish it. Keep a sanitized .env.example in the repo.
env.txt
*.local.env
*.machine.env

# ============================================================
# RUNTIME DATABASES / LOCAL STATE
# ============================================================

*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

sara_data.db
sara_data.db-shm
sara_data.db-wal

# ============================================================
# LOGS / DEBUG OUTPUT
# ============================================================

logs/
*.log
*.log.*
*.trace

debug/
debug_output/
profiling/
*.prof
*.profraw

# ============================================================
# USER-GENERATED / PERSONAL DATA
# ============================================================

notes.json
notes.txt
sara_notes.txt
sara_notes*.txt
sara_class_notes/

memory_export.json
memory_export*.json

sara_memory.json
sara_memory*.json

# Real user voice/query history
sara_unmatched_queries.jsonl
*.jsonl

# Local analytics / usage history
analytics_usage.json
analytics_usage*.json

# Local runtime/state JSON files, without ignoring all normal
# source/config JSON files in the repository.
*.runtime.json
*.local.json
*.user.json
*.state.json

# ============================================================
# LOCAL EXPORTS / GENERATED FILES
# ============================================================

exports/
reports/
generated/
generated_files/

tmp/
temp/
*.tmp
*.temp

# ============================================================
# SCREENSHOTS / DOCUMENTS
# ============================================================

# Ignore PDF files by default; allow repository documentation/assets.
*.pdf
!assets/**/*.pdf
!docs/**/*.pdf

# Do NOT ignore PNG/JPG images globally:
# assets/screenshots/ contains intentional project screenshots.

# ============================================================
# ML / AI MODELS / LARGE MODEL BINARIES
# ============================================================

models/

*.onnx
*.bin
*.pt
*.pth
*.ckpt
*.safetensors
*.tflite
*.gguf
*.ggml

# Common local model/download caches
.cache/
.huggingface/
huggingface/
transformers_cache/

# ============================================================
# BUILD / PACKAGING OUTPUT
# ============================================================

build/
dist/
*.manifest

# Keep sara_ai.spec intentionally tracked.

# ============================================================
# TEST / COVERAGE OUTPUT
# ============================================================

.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
*.cover
test-results.xml

# ============================================================
# TYPE CHECKERS / LINTERS
# ============================================================

.mypy_cache/
.pyright/
.pyre/
.ruff_cache/
.pytype/

# ============================================================
# EDITORS / IDE
# ============================================================

.vscode/
.idea/
*.swp
*.swo
*.swn
*.bak

# ============================================================
# OS JUNK
# ============================================================

Thumbs.db
Desktop.ini
.DS_Store
._*

# ============================================================
# NODE / FRONTEND GENERATED FILES
# ============================================================

node_modules/
.npm/
.yarn/
.pnpm-store/

npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ============================================================
# ARCHIVES / ACCIDENTAL LOCAL PACKAGES
# ============================================================

*.zip
*.7z
*.rar
*.tar
*.tar.gz

# ============================================================
# NOTES
# ============================================================

# Do not add broad rules such as:
#   *.json
#   *.py
#   *.js
#   *.css
#   *.html
#   *.lock
#
# Those can hide legitimate source/config/dependency files.
# Ignore only known runtime/generated/private artifacts.
"""

path = Path("/mnt/data/.gitignore")
path.write_text(content, encoding="utf-8")
print(f"Created: {path}")
print(f"Size: {path.stat().st_size} bytes")
