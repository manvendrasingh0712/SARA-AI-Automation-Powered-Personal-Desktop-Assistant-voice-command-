# SARA AI — Git ignore rules

# Environment / secrets
.env
.env.*
!.env.example
credentials.json
token.json
secrets.json
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer

# Python
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyre/
.coverage
.coverage.*
htmlcov/

# Virtual environments
.venv/
venv/
env/
ENV/

# Runtime data / local state
*.db
*.sqlite
*.sqlite3
*.db-shm
*.db-wal
*.sqlite-shm
*.sqlite-wal
logs/
*.log
runtime/
temp/
tmp/

# Local AI models / caches
models/
model_cache/
.cache/

# Build / packaging
build/
dist/
*.spec.bak
*.manifest
*.pdb

# IDE / editor
.vscode/
.idea/
*.code-workspace
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db
Desktop.ini

# Test / coverage artifacts
.pytest_cache/
.tox/
.nox/
coverage.xml

# Local generated files
*.tmp
*.bak
*.old
