# SARA AI - copy this file to .env and uncomment only what you want to change.
# Commented lines show the default; leave them commented to keep it.

# ── LLM backend ──────────────────────────────────────────────────────
# LLM_BACKEND=gemini                      # "gemini" or "ollama"
# LLM_FALLBACK_ENABLED=                   # fall back to the other backend on failure
# LLM_FALLBACK_MAX_RETRIES=               # retries before falling back
# LLM_MAX_RETRIES=                        # retries per LLM call
# LLM_RETRY_BASE_DELAY_S=                 # first retry delay (seconds)
# LLM_RETRY_MAX_DELAY_S=                  # maximum retry delay (seconds)
# LLM_WARMUP_WAIT_S=                      # max wait for model warm-up (seconds)
# LLM_CIRCUIT_BREAKER_THRESHOLD=          # failures before the breaker opens
# LLM_CIRCUIT_BREAKER_COOLDOWN_S=         # breaker cooldown (seconds)

# ── Ollama (local) ───────────────────────────────────────────────────
# OLLAMA_MODEL=qwen3:4b-instruct-2507-q4_K_M   # main local model
# OLLAMA_FAST_MODEL=                      # optional smaller model for quick replies
# OLLAMA_HOST=http://localhost:11434      # Ollama server URL
# OLLAMA_TIMEOUT=                         # request timeout (seconds)
# OLLAMA_NUM_CTX=                         # context window size
# OLLAMA_SUMMARY_NUM_CTX=                 # context window for summaries
# OLLAMA_NUM_PREDICT=                     # max tokens to generate
# OLLAMA_KEEP_ALIVE=30m                   # how long the model stays loaded
# OLLAMA_TEMPERATURE=                     # sampling temperature
# OLLAMA_TOP_K=                           # top-k sampling
# OLLAMA_TOP_P=                           # top-p sampling
# OLLAMA_REPEAT_PENALTY=                  # repetition penalty

# ── Gemini (cloud) ───────────────────────────────────────────────────
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash           # main Gemini model
# GEMINI_FAST_MODEL=                      # optional faster model for quick replies
# GEMINI_MAX_HISTORY_TOKENS=              # history token budget
# GEMINI_TEMPERATURE=                     # sampling temperature
# GEMINI_TOP_K=                           # top-k sampling
# GEMINI_TOP_P=                           # top-p sampling
# GEMINI_MAX_OUTPUT_TOKENS=               # max tokens to generate
# VISION_MODEL=gemini-2.5-flash           # model used for image understanding

# ── Text-to-speech (Kokoro) ──────────────────────────────────────────
# KOKORO_MODEL_PATH=models/kokoro-v1.0.onnx    # Kokoro ONNX model file
# KOKORO_VOICES_PATH=models/voices-v1.0.bin    # Kokoro voices file
# KOKORO_USE_GPU=True                     # run Kokoro on the GPU
# CUDA_GPU_MEM_LIMIT_BYTES=               # GPU memory cap for ONNX Runtime
# ORT_INTRA_THREADS=                      # ONNX Runtime intra-op threads
# ORT_INTER_THREADS=                      # ONNX Runtime inter-op threads
# KOKORO_VOICE_EN=af_heart                # English voice
# KOKORO_LANG_EN=en-us                    # English language code
# KOKORO_VOICE_HI=hf_alpha                # Hindi voice
# KOKORO_LANG_HI=hi                       # Hindi language code
# KOKORO_SPEED=                           # default speech speed
# KOKORO_SPEED_EN=                        # English speech speed
# KOKORO_SPEED_HI=                        # Hindi speech speed
# TTS_VOLUME=                             # playback volume
# TTS_PLAYBACK_BUFFER_MS=                 # playback buffer (milliseconds)
# TTS_SD_LATENCY=low                      # sounddevice latency mode
# TTS_WARMUP_WAIT_S=                      # max wait for TTS warm-up (seconds)
# TTS_SYNTH_QUEUE_SIZE=                   # synthesis queue length
# TTS_PLAY_QUEUE_SIZE=                    # playback queue length
# TTS_PHRASE_CACHE_SIZE=                  # number of cached phrases
# TTS_PHRASE_CACHE_MAXLEN=                # max characters of a cached phrase
# TTS_BLEED_GUARD_MULTIPLIER=             # mic guard time after speech
# TTS_FIRST_CHUNK_MIN_CHARS=              # min characters in the first spoken chunk
# TTS_FIRST_CHUNK_SOFT_BOUNDARY_MIN_CHARS=  # min characters before a soft split

# ── Identity, language and time ──────────────────────────────────────
# SARA_NAME=Sara                          # assistant name
# SARA_TIMEZONE=Asia/Kolkata              # timezone for times and reminders
# SARA_LANGUAGE=hinglish                  # reply language: english, hindi or hinglish
# LANG_DETECTION_MODE=auto                # language detection mode
# DEBUG_MODE=False                        # verbose debug logging

# ── Wake word ────────────────────────────────────────────────────────
# WAKE_WORD=hey sara                      # primary wake phrase
# WAKE_WORDS=hey sara                     # all accepted wake phrases
# WAKE_ACK_PHRASE=Yes?                    # spoken after the wake word
# WAKE_WORD_ALLOW_CUSTOM_ONLY=True        # accept only the configured phrases
# WAKE_WORD_MODEL_PATH=                   # optional wake-word model file
# WAKE_WORD_FAST_MODEL_SIZE=              # fast wake model size (default is set in config.py)
# WAKE_LISTEN_TIMEOUT_S=                  # wait for speech after wake (seconds)
# WAKE_LISTEN_MAX_DURATION_S=             # max command length after wake (seconds)
# WAKE_FUZZY_MATCH_ENABLED=False          # tolerate near-miss wake phrases
# WAKE_FUZZY_MATCH_THRESHOLD=             # fuzzy match strictness
# WAKE_WORD_COOLDOWN_S=                   # pause between wake detections (seconds)
# WAKE_WORD_THRESHOLD=                    # wake detection sensitivity
# WAKE_WORD_INFERENCE_INTERVAL_S=         # how often wake detection runs (seconds)
# WAKE_WORD_BEAM_SIZE=                    # beam size for wake transcription
# CONTINUOUS_MODE_TIMEOUT=                # follow-up listening window (seconds)

# ── Speech recognition (Whisper) ─────────────────────────────────────
# WHISPER_MODEL_SIZE=medium               # Whisper model size
# WHISPER_BEAM_SIZE=                      # beam size for transcription
# STT_LANGUAGE=                           # force a recognition language
# STT_FORCE_LANG_FOR_HINGLISH=True        # force the language for Hinglish input
# STT_SETTLE_MIN_GAP_S=                   # minimum gap before STT settles (seconds)
# STT_NO_SPEECH_THRESHOLD=                # no-speech probability cut-off
# STT_LOG_PROB_THRESHOLD=                 # average log-probability cut-off
# STT_COMPRESSION_RATIO_THRESHOLD=        # compression-ratio cut-off
# STT_HALLUCINATION_MIN_REPEATS=          # repeats that mark a hallucination
# STT_MIN_CONFIDENCE_REJECT=              # reject transcripts below this confidence
# STT_CONFIDENCE_CONFIRM_THRESHOLD=       # ask for confirmation below this confidence
# STT_HARD_MUTE_DURING_TTS=True           # mute the mic while Sara speaks

# ── Echo cancellation and barge-in ───────────────────────────────────
# AEC_ENABLED=True                        # acoustic echo cancellation
# AEC_SAMPLE_RATE=                        # AEC sample rate (Hz)
# AEC_STREAM_DELAY_MS=                    # AEC stream delay (milliseconds)
# AEC_ENABLE_NS=True                      # AEC noise suppression
# AEC_ENABLE_AGC=False                    # AEC automatic gain control
# AEC_ENABLE_VAD=False                    # AEC voice activity detection
# BARGE_IN_ENABLED=True                   # let the user interrupt Sara
# BARGE_IN_ENERGY_THRESHOLD=              # mic energy that triggers barge-in

# ── Memory, RAG and embeddings ───────────────────────────────────────
# MAX_MEMORY_EXCHANGES=                   # conversation turns kept in memory
# RAG_ENABLED=True                        # use retrieval-augmented memory
# RAG_TOP_K=                              # results retrieved per query
# RAG_MIN_SIMILARITY=                     # minimum similarity for retrieval
# RAG_FACT_MIN_SIMILARITY=                # minimum similarity for stored facts
# RAG_MAX_IN_MEMORY=                      # max vectors held in memory
# EMBEDDING_BACKEND=gemini                # "gemini" or "ollama"
# EMBEDDING_MODEL=gemini-embedding-001    # Gemini embedding model
# OLLAMA_EMBEDDING_MODEL=nomic-embed-text # Ollama embedding model
# EMBEDDING_TIMEOUT_S=                    # embedding request timeout (seconds)
# EMBEDDING_MAX_RETRIES=                  # embedding retries
# EMBEDDING_RETRY_BASE_DELAY_S=           # first embedding retry delay (seconds)
# MEMORY_CONSOLIDATION_ENABLED=True       # merge and tidy stored facts
# MEMORY_CONSOLIDATION_INTERVAL_S=        # seconds between consolidations
# MEMORY_CONSOLIDATION_BATCH_SIZE=        # facts processed per batch
# MEMORY_CONSOLIDATION_MAX_FACTS=         # max facts kept
# MEMORY_FORGET_MATCH_THRESHOLD=          # similarity needed to forget a fact

# ── Tools and planning ───────────────────────────────────────────────
# TOOL_CALLING_ENABLED=True               # let the LLM call tools
# TOOL_CALLING_TIMEOUT_S=                 # tool call timeout (seconds)
# TOOL_CALLING_MODE=llm                   # how tools are chosen
# PLANNING_ENABLED=True                   # multi-step planning
# PLANNING_MAX_STEPS=                     # max steps per plan
# PLANNING_STEP_TIMEOUT_S=                # per-step timeout (seconds)
# PLANNING_TOTAL_TIMEOUT_S=               # whole-plan timeout (seconds)
# PLANNING_STEP_RETRY_ENABLED=True        # retry a failed plan step

# ── Apps and Windows search ──────────────────────────────────────────
# APP_LAUNCH_ALLOWLIST_ENABLED=True       # only launch allow-listed apps
# APP_LAUNCH_ALLOWLIST=                   # allowed apps (default list is set in config.py)
# APP_UNLISTED_SEARCH_FALLBACK_ENABLED=True  # search for apps not on the list
# WINDOWS_SEARCH_TIMEOUT_S=               # Windows search timeout (seconds)
# WINDOWS_SEARCH_SETTLE_S=                # Windows search settle time (seconds)

# ── Proactive suggestions and notifications ──────────────────────────
# PROACTIVE_ENABLED=True                  # let Sara speak up on her own
# PROACTIVE_CHECK_INTERVAL_S=             # how often triggers are checked (seconds)
# PROACTIVE_BATTERY_LOW_PERCENT=          # battery level that triggers a warning
# PROACTIVE_REMINDER_LEAD_MINUTES=        # reminder heads-up time (minutes)
# PROACTIVE_MEETING_LEAD_MINUTES=         # meeting heads-up time (minutes)
# PROACTIVE_IDLE_BREAK_MINUTES=           # idle time before a break suggestion
# PROACTIVE_COOLDOWN_MINUTES=             # minimum gap between suggestions
# PROACTIVE_LLM_PHRASING=True             # let the LLM word suggestions
# NOTIFICATIONS_ENABLED=True              # read out desktop notifications
# NOTIFICATIONS_CHECK_INTERVAL_S=         # notification check interval (seconds)
# REMINDER_CHECK_INTERVAL=                # reminder check interval (seconds)

# ── Smart reminders ──────────────────────────────────────────────────
# Reminders left over from a previous run: how long after their time Sara
# still says one calm line (minutes). Longer than that = notification only.
# Sara picks the window from the reminder text; unknown reminders use DEFAULT.
# REMINDER_GRACE_DEFAULT_MIN=45           # reminders Sara cannot classify
# REMINDER_GRACE_CRITICAL_MIN=15          # meeting, call, travel, medicine, wake up
# REMINDER_GRACE_IMPORTANT_MIN=60         # exam, assignment, project, payment, "urgent"
# REMINDER_GRACE_ROUTINE_MIN=45           # sleep, study, water, food, exercise, break
# CONTEXTUAL_REMINDER_LLM=True            # False = fixed built-in wording only
# CONTEXTUAL_REMINDER_LLM_TIMEOUT_S=4.0   # max wait for the LLM, then built-in wording
# CONTEXTUAL_REMINDER_NOTES_MIN_SCORE=0.45   # below this a note is ignored
# CONTEXTUAL_REMINDER_NOTES_HIGH_SCORE=0.65  # from here a note may be stated outright
# CONTEXTUAL_REMINDER_NUDGE_COOLDOWN_MINUTES=30  # gap between follow-ups (and before the first)
# CONTEXTUAL_REMINDER_MAX_NUDGES=2        # follow-ups per reminder
# CONTEXTUAL_REMINDER_AWAKE_WINDOW_MINUTES=10    # you must have talked to Sara this recently
# CONTEXTUAL_REMINDER_POST_DUE_GRACE_MINUTES=120 # follow-ups stop this long after the reminder

# ── Emergency stop ───────────────────────────────────────────────────
# EMERGENCY_STOP_ENABLED=True             # global stop hotkey
# EMERGENCY_STOP_HOTKEY=ctrl+alt+s        # the hotkey

# ── Briefing, notes and festivals ────────────────────────────────────
# DAILY_BRIEFING_LOCATION=Ajmer,IN        # city for the daily briefing
# NOTES_FOLDER=                           # folder indexed for notes Q&A
# NOTES_CHUNK_CHARS=                      # characters per note chunk
# NOTES_QA_TOP_K=                         # note chunks used per answer
# NOTES_MAX_CHUNKS_PER_FILE=              # max chunks indexed per file
# DIWALI_DATE=                            # Diwali date for greetings (YYYY-MM-DD)
# HOLI_DATE=                              # Holi date for greetings (YYYY-MM-DD)

# ── File paths ───────────────────────────────────────────────────────
# DB_PATH=                                # SQLite database file
# NOTES_FILE_PATH=                        # quick-notes file
# TODO_FILE_PATH=                         # to-do file
# UNMATCHED_LOG_PATH=                     # log of unmatched commands
# GOOGLE_CALENDAR_CREDENTIALS_PATH=       # Google Calendar credentials file
# GOOGLE_CALENDAR_TOKEN_PATH=             # Google Calendar token file

# ---- Security layer -------------------------------------------------------
# SECURITY_MODE=standard                  # standard | strict (confirm every T2 action) | off (dev only)
# SECURITY_INJECTION_THRESHOLD=0.6        # 0.2-0.95; higher = fewer detections
# SECURITY_WARN_ON_INJECTION=True         # tell me once when a page had instructions aimed at me
# SECURITY_SCAN_MAX_CHARS=51200           # scan at most this many characters of untrusted text
# SECURITY_LOG_RETENTION_DAYS=90          # keep security events this long
# SECURITY_LLM_JUDGE=False                # reserved hook, unused in v1

# ---- Memory 2.0 (structured memory, off by default) ------------------------
# MEMORY2_ENABLED=False                   # True = extract facts/events and use them in replies
# MEMORY2_MAX_TURNS_PER_EXTRACT=40        # 5-200 user messages per extraction call
# MEMORY2_MIN_CONFIDENCE=0.5              # drop extracted facts below this
# MEMORY2_SKIP_CATEGORIES=credentials,financial_account,government_id
# MEMORY2_TOPK=5                          # memories added to a reply (1-12)
# MEMORY2_MIN_SCORE=0.25                  # relevance floor for using a memory
# MEMORY2_RETRIEVAL_TIMEOUT_MS=400        # hard limit; on timeout the old memory path runs
# MEMORY2_DECAY_TAU_DAYS=60               # how fast unused memories fade
# MEMORY2_ARCHIVE_THRESHOLD=0.05          # below this strength a memory is archived
# MEMORY2_PURGE_DAYS=90                   # archived/superseded items are deleted after this
# MEMORY2_REFLECTION=False                # reserved, keep off