+  js-test:
+    name: Front-end tests (node)
+    # ubuntu-latest on purpose: these suites are dependency-free Node scripts
+    # that run the real js/ files in a `vm` against a tiny fake DOM. They need
+    # no Windows, no browser and no npm install, so there is no reason to spend
+    # a Windows runner on them. This job is ADDITIVE -- it does not change the
+    # lint or test gates above.
+    runs-on: ubuntu-latest
+    timeout-minutes: 5
+    steps:
+      - name: Checkout repository
+        uses: actions/checkout@v4
+
+      - name: Set up Node
+        uses: actions/setup-node@v4
+        with:
+          node-version: "20"
+
+      - name: Run front-end test suites
+        shell: bash
+        run: |
+          set -e
+          # Each script exits non-zero on any failed assertion.
+          for f in sara/gui/js/tests/*.test.js; do
+            echo "::group::$f"
+            node "$f"
+            echo "::endgroup::"
+          done
+
   type-check:
     name: Type check (mypy, non-blocking)
     runs-on: windows-latest
