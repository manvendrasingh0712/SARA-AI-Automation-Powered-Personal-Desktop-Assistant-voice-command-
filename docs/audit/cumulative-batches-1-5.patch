+    tests can assert e.g. that a correction is attempted exactly once.
+    """
+
+    def __init__(
+        self,
+        mode: str = "valid_plan",
+        steps: Optional[List[Dict[str, Any]]] = None,
+        corrected_arguments: Optional[Dict[str, Any]] = None,
+        corrected_tool: str = "weather",
+        sleep_s: float = 30.0,
