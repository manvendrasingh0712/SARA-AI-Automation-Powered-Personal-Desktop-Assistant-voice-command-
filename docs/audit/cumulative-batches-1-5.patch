+                    "arguments": {"location": "Jaipur"},
+                    "depends_on_previous": False,
+                },
+                {
+                    "tool": "news",
+                    "arguments": {"topic": "cricket"},
+                    "depends_on_previous": False,
+                },
+            ]
+        )
+        self._corrected_arguments = corrected_arguments or {"location": "Jaipur"}
+        self._corrected_tool = corrected_tool
+        self._sleep_s = sleep_s
