+    def toggle_media_mute(self):
+        """Mute/unmute the CURRENTLY SELECTED media session.
+
+        Companion to get_media_volume() / set_media_volume() above: all three
+        act on whatever session _session_cache points at, so the Music page's
+        volume slider and its mute button operate on the same target. This is
+        deliberately distinct from:
+          - toggle_master_mute(), which mutes the Windows output DEVICE, and
+          - toggle_session_mute(app_id), which mutes one EXPLICITLY NAMED app.
+
+        BUGFIX (audit finding D3): sara/gui/js/music.js:414 has always called
+        'toggle_media_mute', but no such method existed on the Api. The call
+        therefore fell through js/core.js to the preview mock (js/mock.js),
+        which answered ok({muted: ...}) -- so the button's icon flipped while
+        nothing was ever actually muted, with no error anywhere. The frontend
+        call site was correct; this method was simply missing.
+        """
+        try:
+            cached_id = _session_cache.get("app_id")
+            if not cached_id:
+                return {"ok": False, "error": "No active media session."}
+            cached_title = _session_cache.get("title")
+            cached_artist = _session_cache.get("artist")
+
+            def _work():
+                session = _pycaw_session_for(cached_id, cached_title, cached_artist)
+                if session is None:
+                    return None
+                vol = session.SimpleAudioVolume
+                vol.SetMute(not bool(vol.GetMute()), None)
+                # Re-query the CONFIRMED mute state rather than trusting our
+                # own write -- same "confirm, don't assume" pattern used by
+                # set_media_volume() and toggle_session_mute().
+                confirmed = bool(vol.GetMute())
+                # Release the COM proxies HERE, still on the COM thread --
+                # never let them live long enough to be GC'd elsewhere.
+                del vol, session
+                return confirmed
+
+            confirmed = _run_on_com_thread(_work)
+            if confirmed is None:
+                return {
+                    "ok": False,
+                    "error": "No matching Windows audio session for this app yet.",
+                }
+            return {"ok": True, "muted": confirmed}
+        except ImportError:
+            return {
+                "ok": False,
+                "error": "pycaw not installed. Run: pip install pycaw",
+            }
+        except Exception as e:
+            print(f"[toggle_media_mute error] {e}")
             return {"ok": False}
